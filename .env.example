# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Legacy fallback for older Supabase projects.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Server and worker only. Prefer the modern Supabase secret key.
SUPABASE_SECRET_KEY=sb_secret_your-project-key
# Legacy fallback for older Supabase projects. Set only when SUPABASE_SECRET_KEY is unavailable.
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Public HTTPS origin of the hosted Next.js app. Used to generate the one-line MCP command.
DIALAI_PUBLIC_URL=https://dialai.example

# Operator-only MCP readiness check. The token is issued by POST /api/mcp/install.
DIALAI_MCP_URL=https://dialai.example/mcp
DIALAI_MCP_TOKEN=call_your-operator-check-key

# Server and worker only voice configuration
CLAWOPS_API_KEY=your-clawops-api-key
CLAWOPS_ACCOUNT_ID=your-clawops-account-id
CLAWOPS_FROM_NUMBER=07012345678
OPENAI_API_KEY=sk-your-openai-api-key
VOICE_WORKER_ID=worker-local-1
VOICE_POLL_INTERVAL_MS=1000

# Live call smoke is disabled unless this is explicitly true and a destination is supplied.
RUN_LIVE_CALL=false
LIVE_CALL_TO=
LIVE_CALL_OBJECTIVE=
LIVE_CALL_CONTEXT=
